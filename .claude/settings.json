{
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run check:*)",
      "Bash(npm run lint)",
      "Bash(npx playwright:*)",
      "WebFetch(domain:scottspence.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:cv.maxdaten.io)"
    ],
    "deny": []
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "*.githubusercontent.com",
        "api.sanity.io",
        "*.api.sanity.io",
        "*.apicdn.sanity.io",
        "cdn.sanity.io",
        "generativelanguage.googleapis.com",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com",
        "cache.nixos.org",
        "*.cachix.org",
        "maxdaten.de",
        "www.maxdaten.de",
        "maxdaten.io",
        "www.maxdaten.io",
        "*.vercel.app"
      ],
      "allowLocalBinding": true,
      "allowUnixSockets": ["/nix/var/nix/daemon-socket/socket"]
    },
    "excludedCommands": [
      "npm run test *",
      "npm run test:unit *",
      "npm run test:all *",
      "npm run test:e2e *",
      "npx vitest *",
      "npx playwright *",
      "e2e *",
      "gate *",
      "git commit *",
      "git push *",
      "git fetch *",
      "git pull *"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/claude-web-session.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); [ -n \"$f\" ] && command -v treefmt >/dev/null 2>&1 || exit 0; treefmt --quiet --on-unmatched=debug \"$f\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$(git rev-parse --show-toplevel)/.claude/statusline.sh\"",
    "padding": 0,
    "refreshInterval": 10
  }
}

{
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run check:*)",
      "Bash(npm run lint)",
      "Bash(npx playwright:*)",
      "WebFetch(domain:scottspence.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:cv.maxdaten.io)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/claude-web-session.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); [ -n \"$f\" ] && command -v treefmt >/dev/null 2>&1 || exit 0; treefmt --quiet --on-unmatched=debug \"$f\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$(git rev-parse --show-toplevel)/.claude/statusline.sh\"",
    "padding": 0,
    "refreshInterval": 10
  }
}

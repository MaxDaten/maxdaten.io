{
    "redirects": [
        {
            "source": "/00-impressum",
            "destination": "/impressum",
            "permanent": true
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "www.maxdaten.io"
                }
            ],
            "destination": "/en",
            "permanent": true
        },
        {
            "source": "/:path(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "www.maxdaten.de"
                }
            ],
            "destination": "https://maxdaten.de/:path",
            "permanent": true
        },
        {
            "source": "/about/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "maxdaten.de"
                }
            ],
            "destination": "https://www.maxdaten.io/about/:path*",
            "permanent": true
        },
        {
            "source": "/:page((?!(?:impressum|datenschutz|404)$)[^/.]+)",
            "has": [
                {
                    "type": "host",
                    "value": "maxdaten.de"
                }
            ],
            "destination": "https://www.maxdaten.io/:page",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/scitylana/js/script.js",
            "destination": "https://plausible.io/js/script.js"
        },
        {
            "source": "/scitylana/api/event",
            "destination": "https://plausible.io/api/event"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.sanity.io; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
                }
            ]
        }
    ]
}
